# Copy to ".env" if you need to change these. Defaults work with the Vite dev proxy.
# API base path (leave as /api in development)
VITE_API_URL=/api
# Backend origin used to load saved images. Leave empty in development (proxy), set to e.g. https://api.example.com in production.
VITE_API_ORIGIN=
# Optional: self-hosted hand_landmarker.task model URL (defaults to Google's public model)
# VITE_HAND_MODEL_URL=/models/hand_landmarker.task